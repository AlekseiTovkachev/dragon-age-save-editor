{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dragon Age Save Editor",
  "version": "0.1.0",
  "identifier": "com.atovk.dragonagesaveeditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Dragon Age Save Editor",
        "width": 1360,
        "height": 820,
        "minWidth": 1360,
        "minHeight": 820,
        "maxWidth": 1360,
        "maxHeight": 820,
        "center": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
