{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dragon Age Save Editor",
  "version": "0.9.0",
  "identifier": "com.atovk.dragonagesaveeditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Dragon Age Save Editor",
        "width": 1360,
        "height": 820,
        "minWidth": 1360,
        "minHeight": 820,
        "maxWidth": 1360,
        "maxHeight": 820,
        "center": true,
        "resizable": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "Aleksei Tovkachev",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "resources": {
      "../data/gamedata.db": "data/gamedata.db"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
