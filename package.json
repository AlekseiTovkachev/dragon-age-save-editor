{
  "name": "dragon-age-save-editor-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint frontend/src --ext .ts,.tsx",
    "test": "vitest run",
    "coverage": "npm run coverage:frontend && npm run coverage:rust",
    "coverage:frontend": "vitest run --coverage",
    "coverage:rust": "node tools/rust-coverage.mjs",
    "smoke": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "verify": "node tools/verify.mjs",
    "data:build": "node tools/python.mjs tools/gamedata/build_gamedata.py",
    "data:verify": "node tools/python.mjs tools/gamedata/verify_gamedata.py",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "lucide-react": "^1.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "typescript": "^5.5.4",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
